# Database: SQLite file used by Prisma, relative to prisma/schema.prisma.
DATABASE_URL=file:./dev.db

# Auth: secret used to sign and verify JWTs. Replace this placeholder locally.
JWT_SECRET=replace-with-a-long-random-secret

# AI: required only when running real Groq evaluations.
GROQ_API_KEY=replace-with-your-groq-api-key
