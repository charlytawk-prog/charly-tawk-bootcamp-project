# Database: local Docker Postgres on your host; production will use the provider's managed Postgres URL later.
DATABASE_URL=postgresql://ops_hub:ops_hub_local@localhost:5432/ops_hub?schema=public
TEST_DATABASE_URL=postgresql://ops_hub:ops_hub_local@localhost:5432/ops_hub_test?schema=public

# Auth: secret used to sign and verify JWTs. Replace this placeholder locally.
JWT_SECRET=replace-with-a-long-random-secret

# AI: required only when running real Groq evaluations.
GROQ_API_KEY=replace-with-your-groq-api-key
