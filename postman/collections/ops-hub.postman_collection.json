{
  "info": {
    "name": "Internal Operations Service Hub",
    "description": "Supplementary API checks for the Ops Hub. The live UI is the product; this collection supplements it. Run the folders in order (Health -> Auth -> Employee -> Boundaries -> Admin). Login requests save their tokens automatically. Demo accounts are TEST-ONLY seed data. Select the 'Ops Hub - Live' or 'Ops Hub - Local' environment to switch targets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://charly-tawk-bootcamp-project-production.up.railway.app" },
    { "key": "demoPassword", "value": "password123" },
    { "key": "aliceToken", "value": "" },
    { "key": "bobToken", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "GET health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('database is up', () => pm.expect(body.database).to.eql('up'));",
                  "pm.test('reports version and commit fields', () => { pm.expect(body).to.have.property('version'); pm.expect(body).to.have.property('commit'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Login as Alice (Employee)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const json = pm.response.json();",
                  "const token = json.accessToken || json.access_token || json.token;",
                  "pm.test('Response contains a token', () => pm.expect(token).to.be.a('string'));",
                  "pm.test('No password hash returned', () => pm.expect(pm.response.text()).to.not.include('passwordHash'));",
                  "pm.collectionVariables.set('aliceToken', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login as Bob (IT Department Agent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const json = pm.response.json();",
                  "const token = json.accessToken || json.access_token || json.token;",
                  "pm.test('Response contains a token', () => pm.expect(token).to.be.a('string'));",
                  "pm.collectionVariables.set('bobToken', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login as Charlie (System Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const json = pm.response.json();",
                  "const token = json.accessToken || json.access_token || json.token;",
                  "pm.test('Response contains a token', () => pm.expect(token).to.be.a('string'));",
                  "pm.collectionVariables.set('adminToken', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"charlie@example.com\",\n  \"password\": \"{{demoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login with wrong password (rejected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Wrong password is rejected with 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "3. Employee",
      "item": [
        {
          "name": "Alice - my tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns an array of tickets', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }],
            "url": "{{baseUrl}}/api/tickets/mine"
          }
        }
      ]
    },
    {
      "name": "4. Boundaries (rejected actions)",
      "item": [
        {
          "name": "My tickets without a token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthenticated request is rejected with 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tickets/mine"
          }
        },
        {
          "name": "Alice - admin users (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Employee is denied admin route with 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{aliceToken}}" }],
            "url": "{{baseUrl}}/api/admin/users"
          }
        },
        {
          "name": "Bob - admin users (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Department Agent is denied admin route with 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bobToken}}" }],
            "url": "{{baseUrl}}/api/admin/users"
          }
        }
      ]
    },
    {
      "name": "5. Admin",
      "item": [
        {
          "name": "Charlie - admin users (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('System Admin can list users', () => pm.response.to.have.status(200));",
                  "pm.test('No password hashes in the response', () => pm.expect(pm.response.text()).to.not.include('passwordHash'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/users"
          }
        }
      ]
    }
  ]
}
